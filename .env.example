# Configuration example - copy to `.env` and edit.
#
# Nested settings use a double underscore: SECTION__FIELD.
# `ila info` prints the resolved values.

# --- ASR (faster-whisper) ---------------------------------------------------
ILA_ASR__MODEL=base.en
ILA_ASR__DEVICE=auto
ILA_ASR__COMPUTE_TYPE=int8
# ILA_ASR__CPU_THREADS=4
ILA_ASR__BEAM_SIZE=5
ILA_ASR__LANGUAGE=en
# Set true once models are downloaded, for a strictly offline deployment.
ILA_ASR__LOCAL_FILES_ONLY=false

# --- Voice activity detection ----------------------------------------------
ILA_VAD__START_MARGIN_DB=8
ILA_VAD__END_MARGIN_DB=3
ILA_VAD__MIN_SILENCE_MS=450
ILA_VAD__MIN_SPEECH_MS=350
ILA_VAD__MAX_SEGMENT_S=20

# --- Live preview captions --------------------------------------------------
ILA_PARTIALS__ENABLED=true
ILA_PARTIALS__AFTER_S=1.2
ILA_PARTIALS__INTERVAL_S=2.0

# --- Audio capture ----------------------------------------------------------
# ILA_AUDIO__DEVICE=1
ILA_AUDIO__BLOCK_MS=40

# --- Local API --------------------------------------------------------------
ILA_SERVER__HOST=127.0.0.1
ILA_SERVER__PORT=8765

# --- Storage ----------------------------------------------------------------
# ILA_HOME=C:/Users/you/.ila
